<Window x:Class="UsdExporterRevit.UI.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsdExporterRevit.UI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="About" Height="270" Width="400">
    <Border>
        <Grid ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Column="0" Grid.Row="0" Margin="8,5,8,5" Stroke="LightGray"/>
            <StackPanel Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="8,5,8,5">
                <TextBlock x:Name="text_title" Text="USD Exporter for Revit" Margin="4,4,4,4" />
                <TextBlock x:Name="text_copyright" Text="Copyright" Margin="4,4,4,4" />
                <TextBlock x:Name="text_build_version" Text="Build" Margin="4,4,4,0" />
                <TextBlock Margin="4,8,4,4">
                    <Hyperlink NavigateUri="https://docs.omniverse.nvidia.com/connect/latest/revit/release-notes.html"
                        ToolTip="https://docs.omniverse.nvidia.com/connect/latest/revit/release-notes.html"
                        RequestNavigate="Hyperlink_RequestNavigate">
                        Release Notes
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="4,4,4,4">
                    <Hyperlink NavigateUri="https://forums.developer.nvidia.com/c/omniverse/connectors/revit/387"
                        ToolTip="https://forums.developer.nvidia.com/c/omniverse/connectors/revit/387"
                        RequestNavigate="Hyperlink_RequestNavigate">
                        Get Support
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="8,5,8,8" VerticalAlignment="Center">
                <Button Content="Close" IsCancel="True" Padding="16,2,16,2" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
